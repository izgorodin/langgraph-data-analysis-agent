# LLM: Gemini (Google) - recommended env vars
LGDA_GEMINI_API_KEY=
LGDA_GEMINI_PROJECT_ID=

# Legacy (optional): GOOGLE_API_KEY (will be mapped to LGDA_GEMINI_API_KEY with a deprecation warning)
GOOGLE_API_KEY=

# BigQuery configuration
LGDA_BIGQUERY_PROJECT_ID=
LGDA_BIGQUERY_LOCATION=US
LGDA_BIGQUERY_DATASET=bigquery-public-data.thelook_ecommerce
LGDA_ALLOWED_TABLES=["orders","order_items","products","users"]
LGDA_SQL_MAX_LIMIT=1000
LGDA_BQ_TIMEOUT_SEC=120
LGDA_MAX_BYTES_BILLED=100000000

# Optional BigQuery credentials (choose ONE):
# 1) Base64-encoded service account JSON
LGDA_BIGQUERY_CREDENTIALS_JSON=
# 2) Or path to service account JSON
LGDA_BIGQUERY_CREDENTIALS=/path/to/key.json
# Standard Google variable is also supported: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Model selection (CLI override with --model provider/model)
LGDA_LLM_PRIMARY=gemini
LGDA_LLM_FALLBACK=bedrock
MODEL_NAME=gemini-1.5-pro

# Environment & Logging
LGDA_ENVIRONMENT=development
LGDA_DEBUG=false
LGDA_LOG_LEVEL=INFO

# AWS / Bedrock (if using Bedrock fallback)
AWS_REGION=eu-west-1
LGDA_BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=

# OpenAI-compatible / OSS hosts
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional vendor-specific (kept for compatibility)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=openai/gpt-oss-120b
